{
  "name": "dsh-supervisor",
  "version": "0.2.7",
  "description": "DSH Supervisor：每会话独立监控、角色责任分配、模型路由、建议采纳与 Handoff。",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harzva/dsh-supervisor.git"
  },
  "homepage": "https://github.com/Harzva/dsh-supervisor#readme",
  "bugs": {
    "url": "https://github.com/Harzva/dsh-supervisor/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/mentor-registry.js",
    "lib/supervisor-store.js",
    "lib/handoff-service.js",
    "lib/roundtable-graph.js",
    "lib/judgement-context.js",
    "lib/execution-state.js",
    "lib/progress-assessment.js",
    "cordis.patch.yml",
    "README.md",
    "INPUTS.md",
    "LICENSE",
    "docs/groupx-supervisor-upgrade.md",
    "docs/01-需求分析.md",
    "docs/02-架构设计.md",
    "docs/03-开发计划.md",
    "docs/05-验收报告.md",
    "docs/smart-supervision-v2/README.md",
    "docs/smart-supervision-v2/01-需求分析.md",
    "docs/smart-supervision-v2/02-架构设计.md",
    "docs/smart-supervision-v2/03-开发计划.md",
    "docs/smart-supervision-v2/04-验收矩阵.md",
    "docs/supervisor-roundtable-graph/01-需求分析.md",
    "docs/supervisor-roundtable-graph/02-架构设计.md",
    "docs/supervisor-roundtable-graph/03-开发计划.md",
    "docs/supervisor-roundtable-graph/NEXT_GOAL.md",
    "docs/supervisor-roundtable-graph/frontend-audit-checklist.md",
    "docs/supervisor-roundtable-graph/issue-11-groupx-badge-evidence.md",
    "docs/supervisor-roundtable-graph/queued-execution.md",
    "docs/supervisor-roundtable-graph/task-brief-for-supervisor.md",
    "lib/project-memory.js",
    "docs/images/supervisor-session-matrix.png"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "preflight": "node scripts/preflight.mjs",
    "scan:public": "node scripts/scan-public.mjs",
    "pack:check": "node scripts/verify-pack.mjs",
    "check": "npm run build && node --check lib/index.js && node --check lib/client.js && node --check lib/mentor-registry.js && node --check lib/supervisor-store.js && node --check lib/handoff-service.js && node --test && npm run preflight",
    "verify:p0": "npm run check && npm run scan:public && npm run pack:check",
    "prepack": "npm run build && npm run preflight && npm run scan:public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@harzva/dsh-role-registry"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "supervisor",
    "mentor",
    "goal",
    "auto-continue"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "peerDependencies": {
    "@harzva/dsh-role-registry": "0.1.0-alpha.1"
  },
  "devDependencies": {
    "@harzva/dsh-role-registry": "https://github.com/Harzva/dsh-role-registry/archive/refs/tags/v0.1.0-alpha.1.tar.gz"
  }
}
